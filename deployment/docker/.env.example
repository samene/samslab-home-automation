# Production environment template for the two Dockerized application
# services (backend, frontend). Copy to `.env` in this same directory and
# fill in real values — `.env` itself must never be committed.
#
#   cp deployment/docker/.env.example deployment/docker/.env
#
# Every native service below (PostgreSQL, VictoriaMetrics, MediaMTX) runs
# outside Docker via systemd on this same VM (or another host reachable over
# the network) — never assume "localhost" resolves to them from inside a
# container. Use the VM's LAN/loopback-bridge address as seen from Docker
# (often the docker0 bridge gateway, e.g. 172.17.0.1, or a real hostname).

# --- Image tags (set by build.sh / deploy.sh; safe to leave as-is) --------
BACKEND_IMAGE=samslab-backend
FRONTEND_IMAGE=samslab-frontend
APP_VERSION=latest

# --- Host port bindings (localhost-only; native Caddy reverse-proxies from
# these) ---------------------------------------------------------------------
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080

# --- Resource limits ---------------------------------------------------------
BACKEND_CPU_LIMIT=1.0
BACKEND_MEMORY_LIMIT=512M
FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEMORY_LIMIT=128M

# --- Core application settings (server/app/config/settings.py) ---------------
SERVER_NAME="Sam's Lab Server"
ENVIRONMENT=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Native PostgreSQL — replace CHANGE_ME_DB_HOST with the address Docker can
# reach it at (never "localhost" from inside a container). Avoid <angle
# brackets> in any value here — this file is sourced as a bash script by
# deployment/docker/lib.sh, and "<"/">" are shell redirection operators.
DATABASE_URL=postgresql+psycopg://samslab:CHANGE_ME@CHANGE_ME_DB_HOST:5432/samslab

# JWT
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_ALGORITHM=HS256
JWT_ISSUER=samslab
JWT_AUDIENCE=samslab-clients
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600
JWT_CLOCK_SKEW_SECONDS=30

# Native MediaMTX — RTSP publishing (agent-side, port 8554) is not this
# server's concern; it only builds the browser-facing WHEP (WebRTC) endpoint
# URL from MEDIAMTX_PLAYBACK_SCHEME/MEDIAMTX_HOST/MEDIAMTX_PLAYBACK_PORT
# below. WebRTC also needs inbound UDP open for ICE/RTP media —
# MediaMTX's webrtcICEUDPMuxAddress single-port-mux mode is the simplest
# config for a server with a public IP.
#
# Leave MEDIAMTX_PLAYBACK_PORT empty (not "0" — actually empty) if a reverse
# proxy/load balancer in front of MediaMTX terminates the scheme's implicit
# default port (443 for https, 80 for http) and forwards internally — the
# browser never needs to see that internal port.
MEDIAMTX_HOST=media.samslab.site
MEDIAMTX_PLAYBACK_SCHEME=https
MEDIAMTX_PLAYBACK_PORT=
# MediaMTX JWT-based read auth: Chrome no longer honors user:pass@host in a
# URL (removed 2022), so the frontend drives playback via WebRTC (WHEP) and
# attaches this JWT as an Authorization header on the SDP-offer POST instead
# — a normal fetch() call, unlike a passive <video src> load, can set that
# header itself with no proxy or workaround needed.
# Generate with: python scripts/generate_mediamtx_jwt_key.py
# Then, in mediamtx.yml, set authJWTJWKS to
# https://<this-server>/api/.well-known/mediamtx-jwks.json — the /api prefix
# matters: Caddy only reverse-proxies /api/* to this backend (see
# deployment/caddy/Caddyfile's handle_path), so the bare, un-prefixed path
# would 404 through the public domain even though the backend's own route
# has no /api in it (Caddy strips the prefix before forwarding). authJWTClaimKey's
# default, mediamtx_permissions, already matches what this app mints.
# Leave MEDIAMTX_JWT_PRIVATE_KEY empty to disable MediaMTX JWT auth entirely.
MEDIAMTX_JWT_PRIVATE_KEY=
MEDIAMTX_JWT_KEY_ID=mediamtx-1
MEDIAMTX_JWT_ISSUER=
MEDIAMTX_JWT_AUDIENCE=
MEDIAMTX_JWT_TTL_SECONDS=60
# MediaMTX only runs one authMethod at a time — once mediamtx.yml sets it to
# "jwt" for browser reads, the agent's RTSP publish connection needs a JWT
# too (there's no internal-database method left running alongside it for
# just that one action). A camera.stream.start command carries a fresh
# publish JWT (this TTL) in its payload for the agent to use; much longer
# than the read TTL above since a stream can run for hours and the agent has
# no token-refresh logic.
MEDIAMTX_JWT_PUBLISH_TTL_SECONDS=86400
CAMERA_STREAM_NAME=camera
CAMERA_COMMAND_TIMEOUT_SECONDS=15.0
CAMERA_COMMAND_POLL_INTERVAL_SECONDS=0.25

# Native VictoriaMetrics
VICTORIA_METRICS_URL=http://CHANGE_ME_VICTORIAMETRICS_HOST:8428

# S3-compatible object storage (reserved for future adapters)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# WebSocket / dispatcher tuning — production defaults; only override if the
# native deployment's latency profile requires it.
WEBSOCKET_PATH=/ws
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_HEARTBEAT_TIMEOUT_SECONDS=10
WS_IDLE_TIMEOUT_SECONDS=90
WS_HELLO_TIMEOUT_SECONDS=10
DISPATCHER_POLL_INTERVAL_SECONDS=1.0
DISPATCHER_ACK_TIMEOUT_SECONDS=10
DISPATCHER_EXECUTION_TIMEOUT_SECONDS=300

# CORS — the frontend's public origin(s); native Caddy is what browsers
# actually talk to, so this is Caddy's public URL(s), not the container port.
ALLOW_ORIGINS=https://samslab.site

# --- Frontend build-time setting (baked in at image build, see build.sh) ----
# Vite inlines this into the JS bundle — it must be the backend's public URL
# as reached through Caddy, not the container's internal port.
VITE_API_BASE_URL=https://samslab.site/api
