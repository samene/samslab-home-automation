# Development-only configuration template. Copy to .env and supply local values.
SERVER_NAME=Sam's Lab Server
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
DATABASE_URL=
JWT_SECRET=
JWT_ALGORITHM=HS256
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
VICTORIA_METRICS_URL=
WEBSOCKET_PATH=/ws
# Comma-separated list of origins the REST API will accept browser requests from
# (e.g. the frontend/ dev server). Leave empty to disable CORS entirely.
ALLOW_ORIGINS=http://localhost:5173

# MediaMTX host reachable by browsers (usually the same host running the RTSP
# server the agent publishes to) and the port it serves browser playback on.
# The server never publishes to MediaMTX itself — only the agent does — this
# is used solely to build the playback_url returned by GET/POST /camera/*.
MEDIAMTX_HOST=127.0.0.1
MEDIAMTX_PLAYBACK_PORT=8889
CAMERA_STREAM_NAME=camera
CAMERA_COMMAND_TIMEOUT_SECONDS=15.0
CAMERA_COMMAND_POLL_INTERVAL_SECONDS=0.25
